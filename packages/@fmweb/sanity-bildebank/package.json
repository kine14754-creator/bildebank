{
  "name": "@fmweb/sanity-bildebank",
  "version": "0.1.0",
  "description": "Sanity Studio plugin — velg bilder fra Bildebank direkte i Studio",
  "keywords": ["sanity", "sanity-plugin", "bildebank", "image", "asset-source"],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external sanity",
    "dev": "tsup src/index.ts --format esm,cjs --dts --external react --external sanity --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fmweb/bildebank": "*"
  },
  "peerDependencies": {
    "react": "^18",
    "sanity": "^3"
  },
  "devDependencies": {
    "@types/react": "^18",
    "react": "^18.3.0",
    "sanity": "^3.64.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
