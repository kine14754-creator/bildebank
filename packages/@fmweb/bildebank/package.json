{
  "name": "@fmweb/bildebank",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the Bildebank image storage API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["sanity", "image", "cloudflare", "workers", "bildebank"]
}